BROKER_HOST=localhost
BROKEN_HOST_DASHBOARD=mosquitto
BROKER_PORT=1883
CLIENTID=go-mqtt-client
TOPIC=v3/your-ttn-app@ttn/devices/your-device/up
MQTT_USERNAME=your-ttn-app@ttn
MQTT_PASSWORD="NNSXS.YOUR_MQTT_API_KEY_HERE"
DB_DSN=postgres://timescaledb:password@localhost:5432/postgres?sslmode=disable
BACKEND_URL=http://localhost:3001

# TTN (The Things Network) credentials for sensor provisioning
TTN_APP_ID=your-ttn-app-id
TTN_API_KEY=NNSXS.YOUR_TTN_API_KEY_HERE

# Path to sensor-pax firmware source (for firmware builds)
SENSOR_PAX_PATH=./sensor-pax

# Docker-compose passwords (defaults are insecure, change for production)
# POSTGRES_PASSWORD=change-me
# GF_ADMIN_PASSWORD=change-me

# CORS allowed origins (comma-separated)
# CORS_ORIGINS=http://localhost:5173,http://localhost:8080
