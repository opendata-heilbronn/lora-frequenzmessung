TAG=latest

FRONTEND_PORT=8080

# Database
POSTGRES_PASSWORD=test-password

# Secrets
INTERNAL_API_KEY=test-internal-key-change-me
JWT_SECRET=test-jwt-secret-at-least-32-chars-long!!

# Admin credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=test-admin-password

# CORS
CORS_ORIGINS=http://localhost:8080

# TTN
TTN_APP_ID=your-test-ttn-app-id
TTN_API_KEY=NNSXS.YOUR_TEST_TTN_API_KEY

# MQTT / TTN Broker
MQTT_USERNAME=your-ttn-app-id@ttn
MQTT_PASSWORD=NNSXS.YOUR_TEST_MQTT_KEY
TOPIC=v3/your-ttn-app-id@ttn/devices/+/up
