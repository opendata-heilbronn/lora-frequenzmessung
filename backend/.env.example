# MQTT / TTN broker connection
BROKEN_HOST=eu1.cloud.thethings.network
BROKEN_PORT=1883
CLIENTID=go-mqtt-client
TOPIC="v3/<your-ttn-app-id>@ttn/devices/+/up"
MQTT_USERNAME="<your-ttn-app-id>@ttn"
MQTT_PASSWORD=<your-ttn-mqtt-password>

# Database
DB_DSN=postgres://timescaledb:password@localhost:5432/postgres?sslmode=disable

# Service URLs
BACKEND_URL=http://localhost:3001
BACKEND_INTERNAL_URL=http://localhost:3001

# Service-to-service auth (shared between Backend, ManagementAPI, Aggregator)
INTERNAL_API_KEY=change-me-to-a-random-secret

# JWT auth (ManagementAPI)
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# TTN device provisioning (ManagementAPI)
TTN_APP_ID=<your-ttn-app-id>
TTN_API_KEY=<your-ttn-api-key>

# Firmware build (ManagementAPI) — path to sensor-pax source directory
# SENSOR_PAX_PATH=../sensor-pax
